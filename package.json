{
  "name": "@creative-int/atoi-plugins",
  "version": "0.1.0",
  "private": true,
  "repoProfile": "agent-plugin-companion",
  "companionOf": "atoi",
  "creativeInt": {
    "repoProfile": "agent-plugin-companion",
    "companionOf": "atoi",
    "workspaceLint": {
      "allowedRootEntries": ["atoi.config.ts"]
    }
  },
  "description": "Portable Atoi skills and generated MCP wiring for Claude Code, Codex, Cursor, and other agent clients.",
  "keywords": [
    "atoi",
    "agent-skills",
    "mcp",
    "projects",
    "workspaces",
    "tasks",
    "proof"
  ],
  "homepage": "https://atoi.app",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/creative-int/atoi-plugins.git"
  },
  "type": "module",
  "files": [
    ".claude-plugin",
    ".codex-plugin",
    ".cursor-plugin",
    ".mcp.json",
    "server.json",
    "atoi.config.ts",
    "LICENSE",
    "README.md",
    "assets/logo.png",
    "skills"
  ],
  "scripts": {
    "generate": "node tooling/generate.ts",
    "check:generated": "node tooling/generate.ts --check",
    "typecheck": "tsc --noEmit",
    "smoke": "node tooling/smoke.ts",
    "verify": "pnpm run check:generated && pnpm run typecheck && pnpm run smoke"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=10.28.2"
  }
}
